# ══════════════════════════════════════════════════════════════════
# .env.example — WhatsApp SaaS Platform
# انسخ هذا الملف إلى .env وأضف قيمك الحقيقية
# ══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# [مطلوب] قاعدة البيانات
# Railway: Variables → DATABASE_URL (مُضاف تلقائياً عند إنشاء PostgreSQL plugin)
# ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/whatsapp_saas
DATABASE_SSL=true
DB_POOL_MAX=5

# [اختياري] مراقبة مساحة PostgreSQL
# السعة القصوى المخصصة لقاعدة البيانات بالبايت؛ عند بلوغ 70% يظهر تنبيه فوري في لوحة التحكم.
POSTGRES_STORAGE_LIMIT_BYTES=10737418240
POSTGRES_STORAGE_ALERT_THRESHOLD_PERCENT=70
# الفاصل بين الفحوصات بالميلي ثانية (الافتراضي: 60000 = دقيقة واحدة)
POSTGRES_STORAGE_MONITOR_INTERVAL_MS=60000
# تنظيف آمن فقط عند 90%+: VACUUM (ANALYZE) للجداول ذات الصفوف الميتة، دون حذف بيانات
POSTGRES_STORAGE_AUTO_VACUUM=true

# إعادة الانضمام التلقائي للمجموعات المؤكدة عند إزالة حساب Telegram
TELEGRAM_AUTO_REJOIN_ON_ACCOUNT_REMOVAL=true
TELEGRAM_MEMBERSHIP_RECOVERY_DIALOG_LIMIT=10000

# ─────────────────────────────────────────────────────────────────
# [مطلوب] Redis
# Railway: Variables → REDIS_URL (مُضاف تلقائياً عند إنشاء Redis plugin)
# أو Upstash: https://upstash.com (مجاني)
# ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://default:password@localhost:6379

# ─────────────────────────────────────────────────────────────────
# [مطلوب] JWT
# أنشئ مفاتيح عشوائية قوية:
#   openssl rand -hex 64
# ─────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_64_output_here
JWT_REFRESH_SECRET=CHANGE_ME_use_openssl_rand_hex_64_output_here_different
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES=7d

# ─────────────────────────────────────────────────────────────────
# [مطلوب] Admin الأولي
# ─────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password_here
# Set true for one deployment only to reset the existing super-admin password,
# then remove it or set false immediately after a successful login.
RESET_ADMIN_PASSWORD=false

# ─────────────────────────────────────────────────────────────────
# [اختياري] PORT
# ⚠️  على Railway: لا تُعيِّن هذا — Railway يُعيِّنه تلقائياً
# للتطوير المحلي فقط:
# ─────────────────────────────────────────────────────────────────
# PORT=5000

# ─────────────────────────────────────────────────────────────────
# [اختياري] البيئة
# ─────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────
# [اختياري] CORS
# أضف domains مفصولة بفاصلة (اتركه فارغاً للسماح بالكل):
# CORS_ORIGINS=https://your-app.railway.app,https://your-domain.com
# ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=

# ─────────────────────────────────────────────────────────────────
# [اختياري] Anti-Ban WhatsApp
# ─────────────────────────────────────────────────────────────────
MAX_RECONNECT_ATTEMPTS=10
MAX_MSG_PER_HOUR=200
MSG_MIN_DELAY_MS=2000
MSG_MAX_DELAY_MS=8000
WARMUP_DAYS=7
WARMUP_LIMIT=30

# ════════════════════════════════════════════════════════
# Phase 5 — Security Hardening
# ════════════════════════════════════════════════════════

# [FIX-17] AES-256-GCM Encryption Key — 64 hex chars
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=your_64_hex_chars_here_replace_me_in_production

# [FIX-14] CSRF — disable in dev only (NEVER in production)
# DISABLE_CSRF=true

# [FIX-15] Rate Limiting — disable in dev only
# DISABLE_RATE_LIMIT=true

# [FIX-13] JWT Refresh Secret (مختلف عن JWT_SECRET)
# JWT_REFRESH_SECRET=another_strong_secret_here

# Telegram MTProto phone authentication (set these in Railway Variables)
# Recommended names:
TELEGRAM_API_ID=your_numeric_api_id
TELEGRAM_API_HASH=your_api_hash
# Legacy aliases also accepted by the server:
# API_ID=your_numeric_api_id
# API_HASH=your_api_hash
# Stable secret used to encrypt Telegram sessions at rest
SESSION_ENCRYPTION_KEY=replace_with_a_long_random_secret

# ════════════════════════════════════════════════════════
# Gemini AI — Smart Conversations (Backend only)
# ════════════════════════════════════════════════════════
# لا تضع المفتاح في Frontend أو Git أو Logs.
GEMINI_ENABLED=false
GEMINI_API_KEY=replace_with_google_ai_studio_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_VERSION=v1
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2
GEMINI_CONCURRENCY=2
GEMINI_RPM=20
# يجب ضبط GEMINI_ENABLED=true فقط بعد وضع مفتاح صالح واختبار endpoint الحقيقي.

# Redis/BullMQ is required for asynchronous Gemini analysis.
# The worker queue name is: gemini-analysis

# Optional public API base URL used by the frontend build.
# VITE_API_URL=

# Google GenAI SDK is initialized only on the backend.

# ══════════════════════════════════════════════════════════════════
# Production resilience — database, Redis, and storage monitoring
# ══════════════════════════════════════════════════════════════════
DB_CONNECTION_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=15000
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_RELAX_PERSISTENCE_GUARD=true

# Application filesystem monitoring (does not inspect or delete PostgreSQL/Redis files)
STORAGE_MONITOR_PATH=/app
STORAGE_MONITOR_INTERVAL_MS=60000
ALERT_STORAGE_WARNING_THRESHOLD=70
ALERT_STORAGE_HIGH_THRESHOLD=80
ALERT_STORAGE_CRITICAL_THRESHOLD=90
ALERT_STORAGE_EMERGENCY_THRESHOLD=95
# Disabled by default. If enabled, only explicitly listed application directories are eligible.
STORAGE_AUTO_CLEANUP=false
APP_CLEANUP_DIRS=
APP_TEMP_RETENTION_MS=86400000

# Optional metrics protection
# METRICS_SECRET=replace_with_a_long_random_secret
POSTGRES_MONITOR_RETENTION_DAYS=90
POSTGRES_MONITOR_AUTO_PRUNE=true
